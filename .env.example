# After copying to `.env`: values with a literal `$` must use `$$` when you run
# `docker compose`, or Compose treats `$name` as a variable (e.g. SMTP_PASSWORD="pa$$word" for `pa$word`).
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/konzession
JWT_SECRET=change-me-min-32-chars-long-secret-key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS comma-separated origins (no trailing slashes). Browsers send the exact scheme+host.
# Local:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production (Railway) — include landing + dashboard + optional Vercel previews:
# CORS_ORIGINS=https://konzessionsuche.at,https://www.konzessionsuche.at,https://dashboard.konzessionsuche.at,https://*.vercel.app
# Password-reset links in email (dashboard base URL, no trailing slash):
# DASHBOARD_ORIGIN=https://dashboard.konzessionsuche.at

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe Price IDs (recurring monthly EUR). Must match Basic €30 / VIP €50 or Checkout shows wrong totals.
# Leave empty to use STRIPE_SUBSCRIPTION_*_UNIT_AMOUNT_CENTS below (3000 = €30, 5000 = €50).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_VIP=
STRIPE_SUBSCRIPTION_BASIC_UNIT_AMOUNT_CENTS=3000
STRIPE_SUBSCRIPTION_VIP_UNIT_AMOUNT_CENTS=5000

# First admin (optional seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ---------------------------------------------------------------------------
# Outbound email (Brevo HTTP API) — used for:
#   password reset, inquiry notification to listing partners, optional Stripe receipt email
# Works locally and on Railway (SMTP ports are often blocked on PaaS).
# ---------------------------------------------------------------------------
# Brevo → SMTP & API → API Keys. Domain and sender must be verified in Brevo.
BREVO_API_KEY=xkeysib-your-api-key
EMAIL_FROM_ADDRESS=office@yourdomain.com
EMAIL_FROM_NAME=Konzession

# ---------------------------------------------------------------------------
# MinIO (S3-compatible) — license image uploads from the seller dashboard.
# Object keys: Licenses/<sellerMongoId>/<uuid>.<ext>
#
# Option A — API + MongoDB + MinIO in Docker (docker-compose.yml in this folder):
#   .\compose.ps1 up -d --build
#   The API container uses Mongo in Compose by default (not MONGODB_URI from this file).
#   To use Mongo on the host instead: DOCKER_MONGODB_URI=mongodb://host.docker.internal:27017/konzession
#
#   MinIO from your browser (host ports): API http://127.0.0.1:9010 — Console http://127.0.0.1:9011/login
#   (Use 9011 on the host, not 9001; 9001 is only inside the container. Login minioadmin / minioadmin12345 unless you changed compose.)
#   With Compose, set uploads/public URL to port 9010, e.g. MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9010/konzession (compose overrides this for the API container).
#
# Option B — API on host (npm run dev), MinIO only in Docker:
#   docker compose up -d minio
#   Use MINIO_ENDPOINT=127.0.0.1, MINIO_PORT=9010, MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9010/konzession
#
# MINIO_PUBLIC_BASE_URL: browser-reachable base including bucket path, no trailing slash
#   With Docker Compose MinIO mapped as 9010:9000, use port 9010 on the host (not 9000):
#   http://127.0.0.1:9010/<MINIO_BUCKET>
#   Production: your HTTPS CDN or public bucket URL (not localhost).
#
# Browsers load <img src="licenseImageUrl"> directly from MinIO. Without public read, the console
# shows "PRIVATE" and images return 403.
#
# Docker Compose: the `minio-init` service runs `mc anonymous set download` on bucket `konzession`
# before the API starts. To re-apply on an existing volume: `docker compose run --rm minio-init`
# from this folder, or run `scripts/minio-public-download.sh` (host `mc` → http://127.0.0.1:9010).
#
# If listings still store `http://minio:9000/...`, public JSON rewrites that host to
# MINIO_BROWSER_PUBLIC_HOST:MINIO_BROWSER_PUBLIC_PORT (defaults 127.0.0.1:9010). Disable with
# MINIO_REWRITE_INTERNAL_MINIO=false.
#
# Railway (API and MinIO in the same project): point the API at MinIO’s private hostname:port.
#   MINIO_ENDPOINT=bucket.railway.internal   (hostname only; no http://)
#   MINIO_PORT=9000
#   MINIO_USE_SSL=false
#   MINIO_PUBLIC_BASE_URL must be a browser-reachable URL (public MinIO / proxy / CDN), e.g.
#   https://<your-minio-public-host>.up.railway.app/listings — not *.railway.internal.
# You may use MINIO_BUCKET_NAME instead of MINIO_BUCKET. MINIO_REGION defaults to us-east-1.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin12345
MINIO_BUCKET=konzession
MINIO_REGION=us-east-1
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9010/konzession
