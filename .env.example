PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/konzession
JWT_SECRET=change-me-min-32-chars-long-secret-key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS comma-separated origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe Price IDs (recurring monthly EUR). Must match Basic €30 / VIP €50 or Checkout shows wrong totals.
# Leave empty to use STRIPE_SUBSCRIPTION_*_UNIT_AMOUNT_CENTS below (3000 = €30, 5000 = €50).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_VIP=
STRIPE_SUBSCRIPTION_BASIC_UNIT_AMOUNT_CENTS=3000
STRIPE_SUBSCRIPTION_VIP_UNIT_AMOUNT_CENTS=5000

# First admin (optional seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ---------------------------------------------------------------------------
# Outbound email (SiteGround or any SMTP) — used for:
#   password reset, optional inquiry notification to listing partners, optional Stripe receipt email
# ---------------------------------------------------------------------------
# SiteGround: Site Tools → Email → [mailbox] → ⋮ → Mail Configuration → Manual settings
#   - Outgoing (SMTP) server host (often mail.yourdomain.com or a host name shown there)
#   - Port: 465 = SSL/implicit TLS (current Konzession config) | 587 = STARTTLS | 2525 = alternate
#   - Username = full mailbox email | Password = that mailbox password | Auth = required
# IMPORTANT: if the password contains `#`, wrap it in double quotes so dotenv does not treat
# the rest of the line as a comment, e.g. SMTP_PASSWORD="my#secret".
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=office@yourdomain.com
SMTP_PASSWORD="your-mailbox-password"
SMTP_FROM="Konzession <office@yourdomain.com>"
# Implicit TLS for port 465 (omit and use port 587 for STARTTLS).
SMTP_SECURE=true
# Set to false only when SiteGround's certificate causes self-signed errors in your environment.
SMTP_TLS_REJECT_UNAUTHORIZED=false
