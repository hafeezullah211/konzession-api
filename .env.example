PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/konzession
JWT_SECRET=change-me-min-32-chars-long-secret-key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS comma-separated origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe Price IDs (recurring monthly EUR). Must match Basic €30 / VIP €50 or Checkout shows wrong totals.
# Leave empty to use STRIPE_SUBSCRIPTION_*_UNIT_AMOUNT_CENTS below (3000 = €30, 5000 = €50).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_VIP=
STRIPE_SUBSCRIPTION_BASIC_UNIT_AMOUNT_CENTS=3000
STRIPE_SUBSCRIPTION_VIP_UNIT_AMOUNT_CENTS=5000

# First admin (optional seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# ---------------------------------------------------------------------------
# Outbound email (SiteGround or any SMTP) — used for:
#   password reset, optional inquiry notification to listing partners, optional Stripe receipt email
# ---------------------------------------------------------------------------
# SiteGround: Site Tools → Email → [mailbox] → ⋮ → Mail Configuration → Manual settings
#   - Outgoing (SMTP) server host (often mail.yourdomain.com or a host name shown there)
#   - Port: 587 = TLS/STARTTLS (typical) | 465 = SSL | 2525 = alternate
#   - Username = full mailbox email | Password = that mailbox password | Auth = required
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Konzession <noreply@example.com>"
# Optional overrides:
# SMTP_SECURE=true          # implicit TLS; omit and use port 587 for STARTTLS (SiteGround default)
# SMTP_TLS_REJECT_UNAUTHORIZED=false   # only if TLS verification breaks (not recommended in production)
